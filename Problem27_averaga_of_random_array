#include <iostream>
#include <cstdlib> // For rand() and srand()
#include <ctime>   // For time() to seed the random generator

using namespace std;

/**
 * Function: GetRandomNumber
 * -------------------------
 * Generates a random integer within a specific range [from, to].
 */
int GetRandomNumber(int from, int to)
{
    return rand() % (to - from + 1) + from;
}

/**
 * Procedure: FillArrayWithRandomNumbers
 * -------------------------------------
 * Prompts user for size and fills the array with random numbers.
 * Uses 'Pass by Reference' for arrLength to reflect changes in main().
 */
void FillArrayWithRandomNumbers(int arr[100], int &arrLength)
{
    cout << "Please enter the number of elements: " << endl;
    cin >> arrLength;

    for (int i = 0; i < arrLength; i++)
    {
        arr[i] = GetRandomNumber(1, 100);
    }
}

/**
 * Procedure: PrintArray
 * --------------------
 * Displays all array elements on a single line.
 */
void PrintArray(int arr[100], int arrLength)
{
    for (int i = 0; i < arrLength; i++)
    {
        cout << arr[i] << " ";
    }
    cout << endl;
}

/**
 * Function: SumOfArrayNumbers
 * --------------------------
 * Calculates the total sum of the array elements.
 */
int SumOfArrayNumbers(int arr[100], int arrLength)
{
    int sum = 0;
    for (int i = 0; i < arrLength; i++)
    {
        sum += arr[i];
    }
    return sum;
}

/**
 * Function: GetAverageOfArrayNumbers
 * ---------------------------------
 * Returns the average of array elements.
 * IMPORTANT: Return type is 'float' to preserve decimal precision.
 */
float GetAverageOfArrayNumbers(int arr[100], int arrLength)
{
    // Reusing SumOfArrayNumbers and casting to float for accuracy
    return (float)SumOfArrayNumbers(arr, arrLength) / arrLength;
}

int main()
{
    // Seed the random number generator
    srand((unsigned)time(NULL));

    int arr[100];
    int arrLength;

    // --- STEP 1: Input & Data Generation ---
    FillArrayWithRandomNumbers(arr, arrLength);

    // --- STEP 2: Output Array ---
    cout << "\nGenerated Array Elements: " << endl;
    PrintArray(arr, arrLength);

    // --- STEP 3: Analysis & Results ---
    cout << "\nAnalysis Result:" << endl;
    cout << "---------------------------------" << endl;
    
    // Display the sum (optional but good for checking)
    cout << "Total Sum   : " << SumOfArrayNumbers(arr, arrLength) << endl;
    
    // Display the average
    cout << "The Average : " << GetAverageOfArrayNumbers(arr, arrLength) << endl;

    cout << "---------------------------------" << endl;

    return 0;
}
