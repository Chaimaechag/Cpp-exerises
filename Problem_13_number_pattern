#include <iostream>
#include <string>
using namespace std;
int ReadPositiveNumber(string message)
{
	int number = 0; 
	do
	{
		cout << message << endl;
		cin >> number;
	} while (number <= 0);
	return number;
}
void PrintNumberPattern(int number)
{
	for (int i = 1; i <= number; i++)
	{
		for (int j = 1; j <= i; j++)
		{
			cout << i ;
		}
		cout << "\n";
	}
}
int main()
{
	PrintNumberPattern(ReadPositiveNumber("please enter the number "));
	return  0;
}
